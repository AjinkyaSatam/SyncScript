{
  "name": "syncscript",
  "version": "1.0.0",
  "description": "Real-time collaborative code editor web application",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev:server": "nodemon server.js",
    "dev:client": "vite",
    "dev": "concurrently \"node server.js\" \"vite\"",
    "build": "vite build",
    "postinstall": "npm run build",
    "start": "node server.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "codemirror": "^5.65.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.2.0",
    "react-avatar": "^5.0.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "vite": "^5.1.6"
  }
}
